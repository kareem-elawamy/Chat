# Visual Studio / Rider directories
.vs/
.idea/
*.sublime-workspace
*.sublime-project

# Visual Studio Code (preserve recommended workspace extensions & settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# ------------------------------------------------------------------------------
# Node.js / Angular 19 Artifacts
# ------------------------------------------------------------------------------
**/node_modules/
**/dist/
**/tmp/
**/out-tsc/
**/.angular/cache/
**/coverage/
**/bazel-out/
.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/typings/
testem.log
/libpeerconnection.log

# ------------------------------------------------------------------------------
# Environment Variables & Local Secret Overrides
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cer
*.crt

# Local backend development configurations containing machine/connection details
API/appsettings.Development.json
API/appsettings.Production.json
API/appsettings.Local.json
API/appsettings.Personal.json
!API/appsettings.json
!API/appsettings.example.json

# ------------------------------------------------------------------------------
# User-Uploaded Content & Generated Local Files
# ------------------------------------------------------------------------------
API/wwwroot/profile_images/*
!API/wwwroot/profile_images/.gitkeep
structure.txt

